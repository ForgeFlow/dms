<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="dms_list.Renderer">
        <div class="dms_treeview">
            <div class="container-fluid dms_document_container ">
                <div class="row o_dms_header btn-group">
                    <button
                        class="btn btn-secondary o_dms_add_directory oi o_hidden"
                        data-icon="database"
                        t-ref="this.dms_add_directory"
                        t-on-click="this.onDMSAddDirectoryRecord"
                    />
                    <div
                        class="o_dms_extra_actions btn-group"
                        t-ref="this.extra_actions"
                    />
                </div>
                <div
                    t-attf-class="row dms_document_row #{this.ui.isSmall ? 'dms_document_mobile' : 'dms_document_desktop'}"
                >
                    <div class="dms_document_col dms_document_col_tree">
                        <div class="dms_document_tree">
                            <div class="dms_content">
                                <div class="dms_tree" t-ref="this.js_tree" />
                            </div>
                        </div>
                    </div>
                    <div
                        class="dms_document_col dms_document_col_preview"
                        t-ref="this.dropZone"
                    >
                        <div t-if="this.dragState.showDragZone" class="o_dropzone">
                            <i
                                class="oi"
                                data-icon="cloud_upload"
                                style="--oi-font-size: 10em"
                            />
                        </div>
                        <div class="dms_document_preview">
                            <t t-call="dms_list.DocumentTreeViewDirectoryPreview" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
    <t t-name="dms_list.DocumentTreeViewDirectoryPreview">
        <div
            class="o_preview_directory"
            t-if="Object.entries(this.nodeSelectedState.data).length !== 0"
            t-att-data-directory-id="this.nodeSelectedState.data.resModel === 'dms.directory' ? this.nodeSelectedState.data.res_id : ''"
        >
            <div class="top_info row">
                <div class="left_info col-4">
                    <div class="o_preview_directory_icon" align="center">
                        <div>
                            <img
                                t-if="this.nodeSelectedState.data.resModel === 'dms.directory'"
                                class="h-100 w-100"
                                t-att-src="this.nodeSelectedState.data.data.icon_url"
                            />
                            <a
                                t-if="this.nodeSelectedState.data.resModel === 'dms.file'"
                                class="o_preview_file"
                                t-att-data-id="this.nodeSelectedState.data.id"
                            >
                                <img
                                    class="h-100 w-100"
                                    t-att-src="this.nodeSelectedState.data.data.icon_url"
                                />
                            </a>
                        </div>
                    </div>
                </div>
                <div class="right_info col-8">
                    <h3>
                        <t t-out="this.nodeSelectedState.data.data.name" />
                    </h3>
                    <t t-if="this.nodeSelectedState.data.resModel === 'dms.directory'">
                        <p>
                            <b>Subdirectories:</b>
                            <span
                                t-out="this.nodeSelectedState.data.data.count_total_directories"
                            />
                        </p>
                        <p>
                            <b>Files:</b>
                            <span
                                t-out="this.nodeSelectedState.data.data.count_total_files"
                            />
                        </p>
                        <p>
                            <b>Size:</b>
                            <span
                                t-if="this.nodeSelectedState.data.data.human_size"
                                t-out="this.nodeSelectedState.data.data.human_size"
                            />
                        </p>
                        <p>
                            <b>Elements:</b>
                            <span
                                t-out="this.nodeSelectedState.data.data.count_elements"
                            />
                        </p>
                    </t>
                    <t t-if="this.nodeSelectedState.data.resModel === 'dms.file'">
                        <p>
                            <b>Size:</b>
                            <span t-out="this.nodeSelectedState.data.data.human_size" />
                        </p>
                    </t>
                    <div class="bottom_buttons">
                        <a
                            t-if="this.nodeSelectedState.data.resModel === 'dms.file'"
                            class="btn btn-primary"
                            t-attf-href="/web/content?id=#{this.nodeSelectedState.data.data.id}&amp;field=content&amp;model=dms.file&amp;filename_field=name&amp;download=true"
                        >
                            <i class="oi" data-icon="download" />
                            Download
                        </a>
                        <button
                            class="btn btn-primary o_preview_file"
                            t-if="this.nodeSelectedState.data.resModel === 'dms.file'"
                            t-on-click="() => this.onDMSPreviewFile(this.nodeSelectedState)"
                        >
                            Open
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
